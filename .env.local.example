# Local development overrides.
#
# Copy to .env.local (which is gitignored). Values here take precedence over .env
# for `pnpm dev` AND for the scripts, so local work never touches Supabase.
#
#   pnpm db:local:up       start local PostgreSQL in Docker
#   pnpm db:migrate        apply migrations to it
#   pnpm seed              load test data (refuses to run against a remote DB)
#   pnpm dev

DATABASE_URL="postgresql://postgres:localdev@127.0.0.1:5433/propertyagent"
DIRECT_DATABASE_URL="postgresql://postgres:localdev@127.0.0.1:5433/propertyagent"

# Local PostgreSQL has no TLS.
DB_SSL="disable"

# Clerk still runs against their servers - there is no local Clerk. Reuse the same
# development keys from .env, or leave these out entirely and .env supplies them.
