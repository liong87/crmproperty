{
  "name": "propertyagent-crm",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx scripts/seed.ts",
    "seed:project-checklist": "tsx scripts/seed-document-checklist-template.ts",
    "demo:sales-kit": "tsx scripts/demo-sales-kit.ts",
    "kit:add-link": "tsx scripts/add-kit-link.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf:preview": "opennextjs-cloudflare build && wrangler dev",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "purge:leads": "tsx scripts/purge-stale-leads.ts",
    "purge:notifications": "tsx scripts/purge-notifications.ts",
    "requirements:inspect": "tsx scripts/inspect-document-requirements.ts",
    "checklist:fix": "tsx scripts/fix-project-checklist.ts",
    "cf:build": "opennextjs-cloudflare build",
    "db:check": "tsx scripts/db-check.ts",
    "db:local:up": "docker compose up -d && echo Waiting for postgres... && timeout 30",
    "db:local:down": "docker compose down",
    "db:local:reset": "docker compose down -v && docker compose up -d",
    "db:local:setup": "pnpm db:migrate && pnpm seed",
    "db:time-reports": "tsx scripts/time-reports.ts",
    "passon:leads": "tsx scripts/pass-on-leads.ts",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "notify:run": "tsx scripts/notify-run.ts",
    "roles:rename": "tsx scripts/rename-manager-role.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@clerk/nextjs": "^6.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.462.0",
    "next": "^15.5.23",
    "postgres": "^3.4.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.0",
    "resend": "^4.0.1",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.28.1",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^4.120.0"
  },
  "pnpm": {
    "overrides": {
      "sharp": "^0.35.0",
      "nanoid": "^3.3.17",
      "postcss": "^8.5.23"
    }
  }
}
