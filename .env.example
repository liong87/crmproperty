# ---- Database (Neon serverless Postgres) ----
# Used ONLY inside lib/db/client.ts. Standard Postgres URL — swappable to RDS/Railway/Hetzner.
#DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL=""

# ---- Auth (Clerk) ----
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL=""
NEXT_PUBLIC_CLERK_SIGN_UP_URL=""


# ---- Storage (Cloudflare R2, S3-compatible) ----
# R2 uses the S3 API. To migrate to AWS S3/B2/MinIO, only change the endpoint + keys.
S3_ENDPOINT=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET=""
S3_PUBLIC_BASE_URL=""

# ---- Email (Resend) ----
RESEND_API_KEY=""
EMAIL_FROM=""

# ---- Error monitoring (Sentry) ----
NEXT_PUBLIC_
# ---- Messaging (WhatsApp) ----
# Phase A: click-to-chat via wa.me (no key needed). Phase B: set provider + token.
MESSAGING_PROVIDER=""
WHATSAPP_CLOUD_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# ---- App ----
APP_TIMEZONE=""
DEFAULT_CURRENCY=""

# ---- Lead capture ----
# Comma-separated "key:landingPageSlug" pairs, one API key per landing page.
PUBLIC_LEAD_API_KEYS=""
TURNSTILE_SECRET_KEY=""
# --- Webhook authentication (one secret per provider; unset = requests rejected) ---
# Generate with: openssl rand -base64 32
WEBHOOK_SECRET_TALLY=""
WEBHOOK_SECRET_TYPEFORM=""
WEBHOOK_SECRET_GOOGLEADS=""
WEBHOOK_SECRET_GENERIC=""

# --- Public lead endpoint CORS allow-list (comma separated, exact origins) ---
# Leave empty for server-to-server posts only (Make, Zapier, Google Ads).
PUBLIC_LEAD_ALLOWED_ORIGINS=""

# --- Meta (Facebook / Instagram) Lead Ads -------------------------------------
# All three are needed together, or leave all three unset.
#   WEBHOOK_SECRET_META    App Secret (App dashboard → Settings → Basic). Verifies
#                          the x-hub-signature-256 header on every delivery.
#   META_VERIFY_TOKEN      Any string you invent. Paste the same value into the
#                          Webhooks product when subscribing to the `leadgen` field.
#   META_PAGE_ACCESS_TOKEN Long-lived PAGE token with the leads_retrieval permission.
#                          Meta's webhook carries no lead data; this fetches it.
# Callback URL to give Meta: https://<your-domain>/api/webhooks/forms/meta
WEBHOOK_SECRET_META=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
# META_GRAPH_VERSION=v21.0
